# =============================================================================
# .gitignore cho dự án Medic
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.so

# --- Virtual environments ---
venv/
.venv/
.venv-runtime/
env/
ENV/
.uv-cache/
.uv-python/

# --- Django ---
*.log
local_settings.py
# db.sqlite3
db.sqlite3-journal
staticfiles/
static/admin/*
!static/admin/css/
static/admin/css/*
!static/admin/css/medic_admin.css
!static/admin/css/medic_admin_shell.css
!static/admin/js/
static/admin/js/*
!static/admin/js/medic_admin.js
static/jazzmin/
/static/assets/build/
/static/assets/docs/
/static/assets/pages/
/static/assets/plugins/

# Media: upload của user. Whitelist file demo bằng !path/to/file nếu cần.
media/

# --- Logs ---
logs/

# --- Environment & secrets ---
.env
.env.*
!.env.example
!.env.production.example

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Build artifacts ---
/build/
/dist/
*.map
*.egg-info/
.eggs/
htmlcov/
.coverage
.pytest_cache/
.mypy_cache/
.tox/

# --- File lớn / installer ---
*.exe
*.zip
*.tar.gz
*.dmg
*.iso
xampp-*.exe

# --- ML model artifacts ---
*.pkl
*.h5

# --- Scratch / file tạm khi dev ---
scratch_*.py
note.txt
test_form.py
test_mail.py

# --- OS / temp ---
*.tmp
*.bak
*.cache

# --- Database backups ---
*.sql.gz
*.dump
db_healthcare/
