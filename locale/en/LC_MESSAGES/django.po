msgid "AI Da liễu"
msgstr "Dermatology AI"

msgid "Sàng lọc tổn thương da bằng AI"
msgstr "AI Skin Lesion Screening"

msgid "Tải ảnh chụp vùng tổn thương da để mô hình CNN HAM10000 phân loại 7 nhóm phổ biến. Kết quả chỉ dùng để sàng lọc ban đầu và không thay thế chẩn đoán của bác sĩ Da liễu."
msgstr "Upload a photo of the skin lesion so the HAM10000 CNN model can classify 7 common groups. Results are for preliminary screening only and do not replace a dermatologist's diagnosis."

msgid "7 nhóm tổn thương"
msgstr "7 lesion groups"

msgid "JPG, PNG, WEBP"
msgstr "JPG, PNG, WEBP"

msgid "Tối đa 5 MB"
msgstr "Up to 5 MB"

msgid "Ảnh rõ, đủ sáng"
msgstr "Clear, well-lit photo"

msgid "Chụp gần 10-15 cm, lấy nét vào nốt ruồi hoặc vùng tổn thương."
msgstr "Take a close photo from 10-15 cm and focus on the mole or lesion."

msgid "Không tự chẩn đoán"
msgstr "Do not self-diagnose"

msgid "Nếu tổn thương thay đổi nhanh, chảy máu, đau hoặc ngứa kéo dài, hãy đi khám."
msgstr "If the lesion changes quickly, bleeds, hurts, or itches for a long time, see a doctor."

msgid "Lưu lịch sử"
msgstr "Save history"

msgid "Người dùng đăng nhập sẽ được lưu kết quả để theo dõi sức khỏe."
msgstr "Logged-in users will have results saved for health tracking."

msgid "Tải ảnh cần sàng lọc"
msgstr "Upload image for screening"

msgid "Ảnh tổn thương da"
msgstr "Skin lesion image"

msgid "Nên dùng ảnh chụp trực diện, không dùng ảnh quá mờ, quá tối hoặc đã chỉnh màu mạnh."
msgstr "Use a front-facing photo. Avoid images that are too blurry, too dark, or heavily color-edited."

msgid "Phân tích bằng AI"
msgstr "Analyze with AI"

msgid "Ảnh xem trước"
msgstr "Image preview"

msgid "Ảnh tổn thương da đã tải lên"
msgstr "Uploaded skin lesion image"

msgid "Ảnh sẽ hiển thị tại đây sau khi bạn chọn file."
msgstr "The image will appear here after you choose a file."

msgid "Kết quả phân tích"
msgstr "Analysis result"

msgid "Cần đi khám Da liễu sớm"
msgstr "See a dermatologist soon"

msgid "Mô hình nghi ngờ nhóm tổn thương nguy hiểm hoặc tiền ung thư. Bạn nên đặt lịch khám chuyên khoa để được soi da và đánh giá trực tiếp."
msgstr "The model suspects a dangerous or precancerous lesion group. You should book a specialist visit for dermoscopy and direct evaluation."

msgid "Chưa thấy tín hiệu nguy cơ cao"
msgstr "No high-risk signal detected"

msgid "Kết quả hiện nghiêng về nhóm lành tính. Nếu tổn thương lớn nhanh, đổi màu, đau, ngứa hoặc chảy máu, bạn vẫn nên đi khám."
msgstr "The result currently leans toward a benign group. If the lesion grows quickly, changes color, hurts, itches, or bleeds, you should still see a doctor."

msgid "Phân bố xác suất 7 lớp"
msgstr "7-class probability distribution"

msgid "Tiền ung thư"
msgstr "Precancerous"

msgid "Theo dõi"
msgstr "Monitor"

msgid "Khuyến nghị"
msgstr "Recommendations"

msgid "7 nhóm mô hình phân loại"
msgstr "7 model classification groups"

msgid "Mã lớp"
msgstr "Class code"

msgid "Quy tắc ABCDE để tự kiểm tra"
msgstr "ABCDE rule for self-checking"

msgid "Asymmetry: hai nửa không đối xứng."
msgstr "Asymmetry: the two halves do not match."

msgid "Border: bờ viền lởm chởm, không đều."
msgstr "Border: jagged or uneven edges."

msgid "Color: nhiều màu trong cùng một nốt."
msgstr "Color: multiple colors in one spot."

msgid "Diameter: đường kính lớn hơn 6 mm."
msgstr "Diameter: larger than 6 mm."

msgid "Evolution: thay đổi theo thời gian."
msgstr "Evolution: changes over time."

msgid "Kết quả nghi ngờ Melanoma - đây là dạng ung thư da nguy hiểm nhất. Hãy đi khám chuyên khoa Da liễu/Ung bướu trong 1-2 ngày tới."
msgstr "The result suggests possible melanoma, the most dangerous skin cancer type. See a dermatologist or oncology specialist within the next 1-2 days."

msgid "Có dấu hiệu của ung thư biểu mô tế bào đáy. Tiên lượng thường tốt nếu phát hiện sớm, bạn nên đi khám chuyên khoa Da liễu sắp tới."
msgstr "There are signs of basal cell carcinoma. Prognosis is often good when detected early, so you should see a dermatologist soon."

msgid "Tổn thương dày sừng quang hóa là tổn thương tiền ung thư. Cần điều trị sớm để tránh tiến triển thành ung thư tế bào gai."
msgstr "Actinic keratosis is a precancerous lesion. Early treatment is needed to avoid progression to squamous cell carcinoma."

msgid "Đa phần nốt ruồi là lành tính. Theo dõi quy tắc ABCDE: Asymmetry, Border, Color, Diameter, Evolution. Khi có thay đổi, hãy đi khám."
msgstr "Most moles are benign. Monitor using the ABCDE rule: Asymmetry, Border, Color, Diameter, Evolution. See a doctor if anything changes."

msgid "Tổn thương dày sừng lành tính thường xuất hiện ở người lớn tuổi. Không nguy hiểm, nhưng nếu ngứa nhiều hoặc chảy máu hãy đi khám."
msgstr "Benign keratosis-like lesions often appear in older adults. They are usually not dangerous, but seek care if they itch a lot or bleed."

msgid "U xơ da thường lành tính, không cần điều trị trừ khi gây khó chịu hoặc ảnh hưởng thẩm mỹ."
msgstr "Dermatofibroma is usually benign and does not need treatment unless it causes discomfort or cosmetic concern."

msgid "Tổn thương mạch máu đa phần lành tính. Hãy theo dõi nếu kích thước thay đổi nhanh."
msgstr "Most vascular skin lesions are benign. Monitor them if size changes quickly."

msgid "Mô hình còn phân vân, xác suất một lớp nguy hiểm khác khá cao. Hãy đi khám trực tiếp để bác sĩ quyết định có cần soi da hoặc sinh thiết hay không."
msgstr "The model is uncertain and another risky class has a relatively high probability. See a doctor directly so they can decide whether dermoscopy or biopsy is needed."

msgid "Đây chỉ là sàng lọc tham khảo bằng AI, KHÔNG thay thế chẩn đoán của bác sĩ Da liễu. Hãy lưu lại ảnh và đi khám sớm để được soi da (dermoscopy)."
msgstr "This is AI-assisted screening for reference only and does NOT replace a dermatologist's diagnosis. Save the image and seek care for dermoscopy."

msgid "Mô hình sàng lọc ung thư da chưa được triển khai. Vui lòng liên hệ quản trị viên."
msgstr "The skin cancer screening model has not been deployed. Please contact the administrator."

msgid "Cảnh báo kết quả sàng lọc da"
msgstr "Skin screening result warning"

msgid "Kết quả sàng lọc nghi ngờ tổn thương nguy hiểm. Vui lòng đi khám Da liễu sớm."
msgstr "The screening result suggests a potentially dangerous lesion. Please see a dermatologist soon."

msgid "Không đọc được ảnh. Vui lòng tải lên ảnh JPG/PNG hợp lệ."
msgstr "The image could not be read. Please upload a valid JPG/PNG image."

msgid "Hệ thống phân tích ảnh tạm thời gặp sự cố. Vui lòng thử lại sau."
msgstr "The image analysis system is temporarily unavailable. Please try again later."

msgid "Vui lòng tải lên một ảnh tổn thương da hợp lệ."
msgstr "Please upload a valid skin lesion image."
