# Copy file này thành .env trên server và điền giá trị thật.
# Không commit file .env thật.

# Django
DJANGO_SECRET_KEY=replace-with-strong-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,server-ip
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_STATIC_ROOT=staticfiles

# HTTPS/proxy
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=2592000
USE_FORWARDED_PROTO=True

# Database
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_APP_USER=app_user
DB_ENGINE=django.db.backends.mysql
DB_NAME=db_healthcare
DB_USER=app_user
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=db
DB_PORT=3306

# Redis / realtime
USE_REDIS_SERVICES=True
CELERY_TASK_ALWAYS_EAGER=True
CHANNEL_LAYER_BACKEND=redis
CHANNEL_REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Medic <noreply@your-domain.com>

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Upload limits
MAX_XRAY_UPLOAD_BYTES=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
MAX_CHAT_ATTACHMENT_BYTES=10485760
ALLOWED_CHAT_ATTACHMENT_CONTENT_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain
ALLOWED_CHAT_ATTACHMENT_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf,.txt

# SMS optional
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

APPOINTMENT_CHANGE_DEADLINE_HOURS=4
